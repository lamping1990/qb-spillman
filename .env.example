# Copy values into Render Dashboard > Environment. Do not commit real secrets.
HOST=0.0.0.0
# Render provides PORT automatically; do not hardcode it on Render.
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DISPATCH_USERNAME=dispatcher
DISPATCH_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
DB_HOST=YOUR_MYSQL_HOST
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_ROTATED_MYSQL_PASSWORD
DB_NAME=YOUR_DATABASE_NAME
TRUST_PROXY=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
